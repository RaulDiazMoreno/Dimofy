<configuration>
    <appender name="file" class="ch.qos.logback.core.FileAppender">
        <file>logs/DimoFy.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="file" />
    </root>
</configuration>

